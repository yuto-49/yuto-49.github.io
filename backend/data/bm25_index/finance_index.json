nesday": 1, "analytical": 1, "powerpoint": 1, "100": 1, "attention": 1, "gain": 1, "precedent": 1, "thursday": 1, "use": 1, "modeling": 1, "balance": 1, "background": 2, "hedge": 2, "jp": 1, "hours": 1, "hour": 1, "calls": 1, "mba": 1, "presentation": 1, "involves": 1, "bloomberg": 1, "compensation": 1, "most": 2, "deal": 1, "banking": 1, "lbo": 1, "transactions": 1, "pressure": 1, "sachs": 1, "tracking": 1, "active": 1, "exit": 1, "development": 1, "educational": 1, "private": 1, "100k": 1, "work": 1, "corporate": 1, "due": 1, "periods": 1, "basic": 1, "research": 2, "capital": 1, "85k": 1, "technical": 2, "programs": 1, "weeks": 1, "opportunities": 2, "principles": 1, "valuation": 1, "under": 1, "long": 1, "company": 1, "preparing": 1, "client": 1, "goldman": 1, "excellent": 1, "base": 2, "friday": 1, "40k": 1, "attending": 1, "merger": 1, "pipeline": 1, "comparables": 1, "funds": 2, "equity": 1, "dcf": 1, "70": 1, "books": 1, "industry": 1, "needed": 1, "firms": 2, "plus": 2, "internships": 1, "incredible": 1, "life": 1, "performing": 1, "degrees": 1, "college": 1, "completed": 1, "venture": 1, "meetings": 1, "especially": 1, "techniques": 1, "investment": 1, "detail": 1, "experience": 1, "database": 1, "making": 1, "live": 1, "critical": 1, "120k": 1, "sigma": 1, "exceed": 1, "street": 1, "stack": 1, "high": 1, "optimization": 1, "statistics": 1, "automated": 1, "technologies": 1, "scientific": 1, "pricing": 1, "phd": 1, "engineering": 1, "cloud": 1, "price": 1, "portfolio": 1, "managers": 1, "large": 1, "ms": 1, "monitoring": 1, "learning": 1, "head": 1, "can": 1, "computing": 1, "prop": 1, "quants": 1, "market": 1, "core": 1, "linux": 1, "trading": 1, "recognition": 1, "cs": 1, "systems": 1, "markets": 1, "machine": 1, "20": 1, "knowledge": 1, "mathematics": 1, "citadel": 1, "platforms": 1, "algorithms": 1, "prediction": 1, "developing": 1, "statistical": 1, "unix": 1, "identify": 1, "backtesting": 1, "programming": 1, "risk": 1, "scikit": 1, "jane": 1, "code": 1, "pattern": 1, "matlab": 1, "management": 1, "collaborating": 1, "projects": 1, "learn": 1, "50": 1, "instruments": 1, "path": 1, "pairs": 1, "combine": 1, "datasets": 1, "derivative": 1, "researcher": 1, "prototyping": 1, "200k": 1, "version": 1, "math": 1, "strategies": 1, "traders": 1, "two": 1, "c": 1, "control": 1, "frequency": 1, "queries": 1, "quantitative": 1, "implementing": 1, "physics": 1, "git": 1, "quant": 1, "breakdown": 1, "historical": 1}, "docs": [{"id": "finance_1_0", "text": "Financial Planning & Analysis (FP&A) analysts play a crucial role in helping companies make data-driven financial decisions. At tech companies like Stripe, Google, and Amazon, FP&A analysts typically split their time between three main activities: 40% on building and maintaining financial models and forecasts, 30% on creating presentations and reports for senior leadership, and 30% on data analysis and variance reporting. Key responsibilities include: Building monthly, quarterly, and annual financial forecasts using Excel and SQL. Analyzing business performance metrics and identifying trends. Creating executive dashboards and KPI reports. Partnering with department heads to understand budget needs. Conducting scenario analysis for strategic decisions. Required skills: Advanced Excel (pivot tables, VLOOKUPs, macros), SQL for data extraction, Python or R for analysis, strong communication skills, and understanding of financial statements. Tools commonly used: Excel, Google Sheets, Tableau, Looker, SQL databases, Python (pandas, numpy). Career progression: Junior Analyst (0-2 years) → Senior Analyst (2-4 years) → FP&A Manager (4-6 years) → Director of FP&A (6-10 years). Typical salary range: $70k-$90k (junior), $90k-$130k (senior), $130k-$180k (manager). Many FP&A professionals come from accounting, finance, or economics backgrounds, but increasingly, data science and computer science graduates are entering the field.", "metadata": {"url": "https://example.com/finance/fp-and-a-analyst", "title": "FP&A Analyst Career Guide", "author": "Finance Team", "date": "2024-01-15", "chunk_idx": 0, "total_chunks": 1}, "tokens": ["financial", "planning", "analysis", "fp", "analysts", "play", "crucial", "role", "helping", "companies", "make", "data", "driven", "financial", "decisions", "tech", "companies", "like", "stripe", "google", "amazon", "fp", "analysts", "typically", "split", "time", "between", "three", "main", "activities", "40", "building", "maintaining", "financial", "models", "forecasts", "30", "creating", "presentations", "reports", "senior", "leadership", "30", "data", "analysis", "variance", "reporting", "key", "responsibilities", "include", "building", "monthly", "quarterly", "annual", "financial", "forecasts", "using", "excel", "sql", "analyzing", "business", "performance", "metrics", "identifying", "trends", "creating", "executive", "dashboards", "kpi", "reports", "partnering", "department", "heads", "understand", "budget", "needs", "conducting", "scenario", "analysis", "strategic", "decisions", "required", "skills", "advanced", "excel", "pivot", "tables", "vlookups", "macros", "sql", "data", "extraction", "python", "r", "analysis", "strong", "communication", "skills", "understanding", "financial", "statements", "tools", "commonly", "used", "excel", "google", "sheets", "tableau", "looker", "sql", "databases", "python", "pandas", "numpy", "career", "progression", "junior", "analyst", "0", "2", "years", "senior", "analyst", "2", "4", "years", "fp", "manager", "4", "6", "years", "director", "fp", "6", "10", "years", "typical", "salary", "range", "70k", "90k", "junior", "90k", "130k", "senior", "130k", "180k", "manager", "many", "fp", "professionals", "come", "accounting", "finance", "economics", "backgrounds", "increasingly", "data", "science", "computer", "science", "graduates", "entering", "field"]}, {"id": "finance_2_0", "text": "Investment banking analysts at firms like Goldman Sachs, Morgan Stanley, and JP Morgan work long hours but gain incredible experience in corporate finance. A typical week involves: Monday-Wednesday: Building financial models (DCF, LBO, merger models) using Excel, preparing pitch books for client meetings, conducting industry and company research, analyzing comparable companies and transactions. Thursday-Friday: Creating presentation materials, attending client calls and meetings, performing due diligence for deals, updating deal pipeline tracking. Analysts use advanced Excel modeling, PowerPoint for presentations, FactSet and Bloomberg terminals for financial data, and Tableau for data visualization. The role requires strong analytical skills, attention to detail, ability to work under pressure, and excellent communication skills. Educational background: Most analysts have degrees in finance, economics, or business, with many having completed internships during college. Technical skills needed: Financial modeling, valuation techniques (DCF, comparables, precedent transactions), Excel VBA, basic Python or R for data analysis, understanding of accounting principles and financial statements. Work-life balance: Expect 70-100 hour weeks, especially during active deal periods. Compensation: Base salary $85k-$100k plus bonuses of $40k-$70k. Exit opportunities: Private equity, hedge funds, corporate development, venture capital, or MBA programs.", "metadata": {"url": "https://example.com/finance/investment-banking", "title": "Investment Banking Analyst Responsibilities", "author": "IB Careers", "date": "2024-02-20", "chunk_idx": 0, "total_chunks": 1}, "tokens": ["investment", "banking", "analysts", "firms", "like", "goldman", "sachs", "morgan", "stanley", "jp", "morgan", "work", "long", "hours", "gain", "incredible", "experience", "corporate", "finance", "typical", "week", "involves", "monday", "wednesday", "building", "financial", "models", "dcf", "lbo", "merger", "models", "using", "excel", "preparing", "pitch", "books", "client", "meetings", "conducting", "industry", "company", "research", "analyzing", "comparable", "companies", "transactions", "thursday", "friday", "creating", "presentation", "materials", "attending", "client", "calls", "meetings", "performing", "due", "diligence", "deals", "updating", "deal", "pipeline", "tracking", "analysts", "use", "advanced", "excel", "modeling", "powerpoint", "presentations", "factset", "bloomberg", "terminals", "financial", "data", "tableau", "data", "visualization", "role", "requires", "strong", "analytical", "skills", "attention", "detail", "ability", "work", "under", "pressure", "excellent", "communication", "skills", "educational", "background", "most", "analysts", "degrees", "finance", "economics", "business", "many", "having", "completed", "internships", "during", "college", "technical", "skills", "needed", "financial", "modeling", "valuation", "techniques", "dcf", "comparables", "precedent", "transactions", "excel", "vba", "basic", "python", "r", "data", "analysis", "understanding", "accounting", "principles", "financial", "statements", "work", "life", "balance", "expect", "70", "100", "hour", "weeks", "especially", "during", "active", "deal", "periods", "compensation", "base", "salary", "85k", "100k", "plus", "bonuses", "40k", "70k", "exit", "opportunities", "private", "equity", "hedge", "funds", "corporate", "development", "venture", "capital", "mba", "programs"]}, {"id": "finance_3_0", "text": "Quantitative analysts (quants) at hedge funds and prop trading firms like Citadel, Two Sigma, and Jane Street combine finance with advanced mathematics and programming. Role breakdown: 50% developing and implementing trading algorithms and models, 30% analyzing market data and backtesting strategies, 20% collaborating with traders and portfolio managers. Core responsibilities: Building statistical models for price prediction and risk management. Developing automated trading strategies using Python, C++, or R. Analyzing large datasets to identify trading opportunities. Implementing machine learning models for pattern recognition. Backtesting strategies on historical data. Monitoring live trading systems and performance. Required technical skills: Strong programming in Python (pandas, numpy, scikit-learn), C++ for high-frequency trading, R for statistical analysis, SQL for database queries, knowledge of machine learning and statistics, understanding of financial markets and instruments. Math/CS background: Most quants have MS or PhD in mathematics, physics, computer science, or financial engineering. Tools and technologies: Python scientific stack, C++ for performance-critical code, MATLAB for prototyping, Git for version control, Linux/Unix systems, cloud computing platforms. Typical projects: Pairs trading strategies, market-making algorithms, risk models, portfolio optimization, derivative pricing models. Salary: $120k-$200k base plus bonuses that can exceed base salary. Career path: Junior Quant → Senior Quant → Quant Researcher → Portfolio Manager or Head of Quant Research.", "metadata": {"url": "https://example.com/finance/quantitative-analyst", "title": "Quantitative Analyst in Finance", "author": "Quant Finance", "date": "2024-03-10", "chunk_idx": 0, "total_chunks": 1}, "tokens": ["quantitative", "analysts", "quants", "hedge", "funds", "prop", "trading", "firms", "like", "citadel", "two", "sigma", "jane", "street", "combine", "finance", "advanced", "mathematics", "programming", "role", "breakdown", "50", "developing", "implementing", "trading", "algorithms", "models", "30", "analyzing", "market", "data", "backtesting", "strategies", "20", "collaborating", "traders", "portfolio", "managers", "core", "responsibilities", "building", "statistical", "models", "price", "prediction", "risk", "management", "developing", "automated", "trading", "strategies", "using", "python", "c", "r", "analyzing", "large", "datasets", "identify", "trading", "opportunities", "implementing", "machine", "learning", "models", "pattern", "recognition", "backtesting", "strateg